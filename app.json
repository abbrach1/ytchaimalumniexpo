{
  "expo": {
    "name": "YTC Alumni",
    "slug": "ytcalumninew",
    "owner": "abbrachfelds-organization",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ytcalumni",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#19263F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "toraschaim.ytcalumni1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["audio", "remote-notification"],
        "NSMicrophoneUsageDescription": "This app requires microphone access for audio playback controls.",
        "NSCameraUsageDescription": "This app may use the camera for profile photos.",
        "NSPhotoLibraryUsageDescription": "This app requires photo library access for profile photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#19263F"
      },
      "package": "toraschaim.ytcalumni1",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "222e9a56-1d69-49bc-a88c-53967c430736"
      }
    }
  }
}
